# Database Configuration
DATABASE_URL=postgres://username:password@host:port/database

# Smart Contract Configuration
CONTRACT_ADDRESS=0x71a3D451AF93CBc5c8ec7f90846dAD349a42D93d

# ENI Network Configuration
RPC_URL=https://rpc.eniac.network
CHAIN_ID=173

# Batch Processing Configuration
# BATCH_SIZE=3          # Number of parallel transactions per batch (start conservative!)
# BATCH_DELAY=5000      # Delay between batches in milliseconds
# MAX_RETRIES=3         # Maximum retry attempts for failed transactions
# RETRY_DELAY=10000     # Delay before retrying failed transactions (ms)

# Cron Schedule Configuration
# CRON_SCHEDULE=0 8 * * *          # Default: Daily at 8:00 AM (cron format: minute hour day month weekday)
# TIMEZONE=Asia/Singapore           # Timezone for cron schedule (UTC+8: Asia/Singapore, Asia/Hong_Kong, Asia/Taipei, Asia/Shanghai)
# RUN_ON_STARTUP=true              # Run immediately when bot starts (true/false)

# Alternative RPC endpoints (comment/uncomment as needed):
# RPC_URL=wss://rpc.eniac.network/ws/           # WebSocket endpoint
# RPC_URL=https://rpc-testnet.eniac.network     # Testnet (Chain ID: 174)
# RPC_URL=wss://rpc-testnet.eniac.network/ws/   # Testnet WebSocket

